	<munit:test name="update-products-test" doc:id="c319f71d-ab12-46d2-90bc-dff8feb108cf" >
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock when SF Update" doc:id="b914e4a7-23e7-44cd-b9d2-90eb520e6647" processor="salesforce:update" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="b8cb70b3-9ef9-405f-94a8-9037f022b9d5" attributeName="doc:id" />
